# ──────────────────────────────────────────────────────────────────────────────
# SkillBridge — Environment Variables
# ──────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in the values.
# Never commit .env to version control.
# ──────────────────────────────────────────────────────────────────────────────

# ─── Database (Required) ────────────────────────────────────────────────────
# PostgreSQL connection string. For Vercel, use a cloud provider like
# Neon, Supabase, or Vercel Postgres.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/skillbridge?schema=public"

# ─── NextAuth.js (Required) ─────────────────────────────────────────────────
# Base URL for the application. On Vercel, set to your production domain.
# On local dev, use http://localhost:3000
NEXTAUTH_URL="http://localhost:3000"

# Secret used to sign JWT tokens. Generate with: openssl rand -base64 32
# NEVER use a weak or default secret in production.
NEXTAUTH_SECRET="your-secret-key-change-in-production"

# ─── OAuth Providers (Optional) ──────────────────────────────────────────────
# Uncomment and configure if you add OAuth sign-in providers.

# Google
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# GitHub
# GITHUB_ID=""
# GITHUB_SECRET=""
